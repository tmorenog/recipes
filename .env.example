# For running locally. Get real values with: vercel env pull .env.local
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
CLASS_KEY=one-long-random-key-for-the-whole-class
# Or, instead of Supabase, a Postgres connection string:
# POSTGRES_URL=postgres://user:password@host:5432/dbname

# Kroger developer app, for the Meal Planner price lookups
KROGER_CLIENT_ID=your-kroger-client-id
KROGER_CLIENT_SECRET=your-kroger-client-secret
