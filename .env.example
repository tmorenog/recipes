# For running locally. Get real values with: vercel env pull .env.local
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
GROUP_KEYS=team-1:replace-with-a-long-random-key,team-2:another-long-random-key
# Or, instead of Supabase, a Postgres connection string:
# POSTGRES_URL=postgres://user:password@host:5432/dbname
