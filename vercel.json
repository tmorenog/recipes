{
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/api/mcp/",
      "destination": "/api/mcp"
    },
    {
      "source": "/api/recipes/:id/processed",
      "destination": "/api/recipes?id=:id&action=processed"
    },
    {
      "source": "/api/kroger/:what",
      "destination": "/api/kroger?what=:what"
    },
    {
      "source": "/api/admin/:action",
      "destination": "/api/admin?action=:action"
    }
  ],
  "redirects": [
    {
      "source": "/database",
      "destination": "/coordinator",
      "permanent": false
    }
  ],
  "functions": {
    "api/backup.js": {
      "maxDuration": 300
    }
  }
}
